#
# frank-castle — link every psyz module (overlay) statically.
#
# For each overlay:  ld -r its objects into one ovl_<name>.o, rename the psyz
# entry points to <name>__module_start/stop and make every other symbol it
# defines local. Stages that define the same global (there are >150 such
# names across overlays) then never collide, with no hand-kept list.
#
# Also generates:
#   castle_overlays.ld    OVERLAY blocks, one PSRAM slot per kind
#   castle_modules.c      the name -> entry point / data image table
#
set(CASTLE_OVL_DIR ${CMAKE_BINARY_DIR}/ovl)
file(MAKE_DIRECTORY ${CASTLE_OVL_DIR})
set(CASTLE_OVL_OBJECTS)
set(_slots stage weapon0 weapon1 servant)
foreach(s ${_slots})
    set(_ovl_${s})
endforeach()

foreach(ovl ${SOTN_OVERLAYS})
    if(ovl MATCHES "^w0_")
        set(_slot weapon0)
    elseif(ovl MATCHES "^w1_")
        set(_slot weapon1)
    elseif(ovl MATCHES "^tt_")
        set(_slot servant)
    else()
        set(_slot stage)
    endif()
    list(APPEND _ovl_${_slot} ${ovl})
    set(MOD_SLOT_${ovl} ${_slot})

    set(_out ${CASTLE_OVL_DIR}/ovl_${ovl}.o)
    add_custom_command(OUTPUT ${_out}
        COMMAND ${CMAKE_C_COMPILER} -nostdlib -r -o ${_out}.r $<TARGET_OBJECTS:ovl_${ovl}>
        COMMAND ${CMAKE_OBJCOPY}
            --redefine-sym psyz_module_start=${ovl}__module_start
            --redefine-sym psyz_module_stop=${ovl}__module_stop
            --keep-global-symbol=${ovl}__module_start
            --keep-global-symbol=${ovl}__module_stop
            ${_out}.r ${_out}
        DEPENDS ovl_${ovl} $<TARGET_OBJECTS:ovl_${ovl}>
        COMMAND_EXPAND_LISTS
        COMMENT "overlay ${ovl}")
    list(APPEND CASTLE_OVL_OBJECTS ${_out})
endforeach()
set_source_files_properties(${CASTLE_OVL_OBJECTS} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)

# castle_overlays.ld
set(_ld "/* Generated by cmake/overlays.cmake. Do not edit. */\n")
foreach(s ${_slots})
    if(NOT _ovl_${s})
        continue()
    endif()
    string(APPEND _ld "OVERLAY : NOCROSSREFS {\n")
    foreach(ovl ${_ovl_${s}})
        string(APPEND _ld "    ovl_${ovl} { *ovl_${ovl}.o(.data .data.* .bss .bss.* COMMON) . = ALIGN(4); }\n")
    endforeach()
    list(GET _ovl_${s} 0 _first)
    string(APPEND _ld "} > PSRAM AT> FLASH\n__ovl_slot_${s} = ADDR(ovl_${_first});\n. = ALIGN(16);\n\n")
endforeach()
file(WRITE ${CMAKE_BINARY_DIR}/castle_overlays.ld "${_ld}")

# castle_modules.c
set(_c "/* Generated by cmake/overlays.cmake. Do not edit. */\n#include \"module_static.h\"\n\n")
foreach(s ${_slots})
    string(APPEND _c "extern uint8_t __ovl_slot_${s}[];\n")
endforeach()
foreach(ovl ${SOTN_OVERLAYS})
    string(APPEND _c "extern void ${ovl}__module_start(void*);\nextern void ${ovl}__module_stop(void);\n")
    string(APPEND _c "extern const uint8_t __load_start_ovl_${ovl}[], __load_stop_ovl_${ovl}[];\n")
endforeach()
string(APPEND _c "\nconst StaticModule g_StaticModules[] = {\n")
foreach(ovl ${SOTN_OVERLAYS})
    string(TOUPPER ${MOD_SLOT_${ovl}} _S)
    string(APPEND _c "    {\"${ovl}\", MODULE_SLOT_${_S}, ${ovl}__module_start, ${ovl}__module_stop, __load_start_ovl_${ovl}, __load_stop_ovl_${ovl}, __ovl_slot_${MOD_SLOT_${ovl}}},\n")
endforeach()
list(LENGTH SOTN_OVERLAYS _n)
string(APPEND _c "};\nconst unsigned g_StaticModuleCount = ${_n};\n")
file(WRITE ${CMAKE_BINARY_DIR}/castle_modules.c "${_c}")
